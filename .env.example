# Copy to .env on the server and fill real values.
# NEVER commit the real .env to git.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mhkaman.com,www.mhkaman.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mhkaman.com,https://www.mhkaman.com
DJANGO_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

